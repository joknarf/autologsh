#!/bin/bash
### Timestamped logs/rotate
#
# Author: Franck Jouvanceau

_log_help() {
    printf '%s\n' '
usage: [<vars>] autologsh [--nolog] <command>|- [<args>]
with vars default:
  logfile=~/.autolog/<command>.log or autologsh.log for -
  maxsize=5M nrotate=4
  timeformat=[%Y-%m-%d %H:%M:%S]
'
}

_log_vars() {
    : ${logfile:=~/.autolog/"${0##*/}".log}
    logdir="${logfile%/*}"
}

function log_rotate {
    typeset logdir logfile="$logfile"
    typeset maxsize="${maxsize:-5M}"
    typeset nrotate="${nrotate:-4}"
    _log_vars
    typeset logconf="$logdir/.logrotate"
    cat - <<EOF >"$logconf"
$logfile {
    maxsize $maxsize
    rotate $nrotate
    compress
    create
}
EOF
    logrotate --state "$logconf.s" "$logconf"
}

_log_ts() {
    awk '{print strftime(tf), $0; fflush() }' tf="$timeformat"
}

_log_out() {
    if ((log));then _log_ts |tee -a "$logfile" 
    else _log_ts
    fi
}

function do_log {
    typeset logdir logfile="$logfile" timeformat="${timeformat:-[%Y-%m-%d %H:%M:%S]}" cmd log=1
    [ "$1" = --nolog ] && log=1 && shift
    ((log)) && {
        [ "$1" ] && [ "$1" != '-' ] && : ${logfile:=~/.autolog/"$1".log}
        _log_vars
        mkdir -p "$logdir" || return 1
        touch "$logfile" || return 1
        log_rotate
        echo '---------------------------------' >>"$logfile"
    }
    [ "$1" = "-" ] && { _log_out; return; }
    if [ "$1" ] ;then "$@" 2>&1 | _log_out
    else exec > >(_log_out) 2>&1
    fi
}

function log {
    typeset logformat="${logformat:-%-5s %-10s %s\n}"
    printf "$logformat" "$@"
}

[[ "$1" = -*h* ]] && _log_help || do_log "$@"
