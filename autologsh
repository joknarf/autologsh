### Timestamped logs/rotate
# logfile=<logfile> [maxsize<maxsize>] [nrotate=<nrotate>] source <path>/autolog.sh
# ex:
#   logfile=~/log/app.log maxsize=5M nrotate=4 source ./autologsh
#
# defaults: <logfile> ~/.autolog/log_<tty> <maxsize>: 5M <nrotate>: 4
#
# Author: Franck Jouvanceau

log_vars() {
    : ${logfile:=~/.autolog/"${0##*/}".log}
    logdir="${logfile%/*}"
}

function log_rotate {
    typeset logdir logfile="$logfile"
    typeset maxsize="${maxsize:-5M}"
    typeset nrotate="${nrotate:-4}"
    log_vars
    typeset logconf="$logdir/.logrotate"
    cat - <<EOF >"$logconf"
$logfile {
    maxsize $maxsize
    rotate $nrotate
    compress
    create
}
EOF
    logrotate --state "$logconf.s" "$logconf"
}

function do_log {
    typeset logdir logfile="$logfile" timeformat="${timeformat:-[%Y-%m-%d %H:%M:%S]}"
    [ "$1" = --nolog ] && {
       exec > >(awk '{print strftime(tf), $0; fflush() }' tf="$timeformat") 2>&1
       return
    }
    log_vars
    mkdir -p "$logdir" || return 1
    touch "$logfile" || return 1
    log_rotate
    echo '---------------------------------' >>"$logfile"
    exec > >(awk '{print strftime(tf), $0; fflush() }' tf="$timeformat" |tee -a "$logfile") 2>&1
}

function log {
    typeset logformat="${logformat:-%-5s %-10s %s\n}"
    printf "$logformat" "$@"
}

do_log "$@"
